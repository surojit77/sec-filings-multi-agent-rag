# SEC requires a User-Agent with your name + email (fair-access policy)
SEC_USER_AGENT="Your Name your.email@example.com"

# Any OpenAI-compatible endpoint. Default = local vLLM server (scripts/serve_vllm.sh)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional separate judge model for eval-qa (defaults to the LLM above)
# JUDGE_BASE_URL=http://localhost:8001/v1
# JUDGE_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Dense retrieval model (sentence-transformers). Set EMBEDDER=hash for a no-download smoke test.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDER=hash

SECRAG_DATA_DIR=data
